{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=propbuild;Username=propbuild;Password=change-me"
  },
  "Jwt": {
    "Issuer": "PropBuild",
    "Audience": "PropBuild",
    "SigningKey": "development-only-change-this-to-a-32-character-minimum-secret"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
